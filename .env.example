# Local application and Deribit TestNet configuration.
APP_ENV=development
LOG_LEVEL=INFO
DERIBIT_TESTNET=true
DERIBIT_TESTNET_CLIENT_ID=
DERIBIT_TESTNET_CLIENT_SECRET=
# Leave false until you intentionally want the UI to submit TestNet orders.
DERIBIT_TESTNET_ORDER_SUBMISSION_ENABLED=false
LIVE_TRADING_ENABLED=false

# Optional default local model for the Streamlit BTC chat
OLLAMA_MODEL=
